{
  "name": "getback-desktop",
  "productName": "GetBack",
  "version": "0.2.0",
  "description": "姿勢モニター（GetBackクローン）デスクトップ常駐版",
  "main": "main.js",
  "author": "STONY & Co.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare.js",
    "start": "npm run prepare-assets && electron .",
    "dist": "npm run prepare-assets && electron-builder --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "jp.stony.getback",
    "productName": "GetBack",
    "files": [
      "main.js",
      "preload.js",
      "overlay/**",
      "renderer/**",
      "assets/**",
      "product.json",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "姿勢を判定するためにカメラを使用します（映像は端末内で処理され、送信・保存されません）",
        "LSUIElement": false
      },
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "GetBack-portable-${version}.exe"
    }
  }
}